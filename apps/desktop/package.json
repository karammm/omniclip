{
  "name": "@omniclip/desktop",
  "productName": "OmniClip",
  "version": "0.1.0",
  "private": true,
  "description": "One clipboard for every device on your Wi-Fi",
  "author": "OmniClip",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
    "dist:mac": "node build.mjs && electron-builder --mac",
    "dist:win": "node build.mjs && electron-builder --win"
  },
  "dependencies": {
    "@omniclip/hub": "0.1.0",
    "@omniclip/protocol": "0.1.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.omniclip.app",
    "productName": "OmniClip",
    "directories": { "output": "release", "buildResources": "assets" },
    "files": ["dist/**", "package.json", "!node_modules/**"],
    "extraResources": [
      { "from": "assets", "to": "assets", "filter": ["tray*.png", "icon.png"] },
      { "from": "../web/dist", "to": "web" }
    ],
    "icon": "assets/icon.png",
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "LSUIElement": true,
        "NSLocalNetworkUsageDescription": "OmniClip shares your clipboard with your other devices on this network.",
        "NSBonjourServices": ["_omniclip._tcp"]
      }
    },
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}

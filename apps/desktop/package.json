{
  "name": "@omniclip/desktop",
  "productName": "OmniClip",
  "version": "0.5.0",
  "license": "MIT",
  "private": true,
  "description": "One clipboard for every device on your Wi-Fi",
  "author": {
    "name": "karammm",
    "email": "56406583+karammm@users.noreply.github.com"
  },
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
    "dist:mac": "node build.mjs && electron-builder --mac --publish never",
    "dist:win": "node build.mjs && electron-builder --win --publish never",
    "dist:linux": "node build.mjs && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@omniclip/hub": "0.5.0",
    "@omniclip/protocol": "0.5.0",
    "electron": "45.0.0",
    "electron-builder": "^26.0.0",
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "com.omniclip.app",
    "productName": "OmniClip",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "tray*.png",
          "icon.png"
        ]
      },
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "icon": "assets/icon.png",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "LSUIElement": true,
        "NSLocalNetworkUsageDescription": "OmniClip shares your clipboard with your other devices on this network.",
        "NSBonjourServices": [
          "_omniclip._tcp"
        ]
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "omniclip",
      "category": "Utility",
      "synopsis": "One clipboard for every device on your Wi-Fi",
      "maintainer": "karammm <56406583+karammm@users.noreply.github.com>",
      "desktop": {
        "entry": {
          "StartupWMClass": "omniclip"
        }
      },
      "artifactName": "OmniClip-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "OmniClip-Setup-${version}-${arch}.${ext}"
    },
    "copyright": "Copyright © 2026 karammm",
    "artifactName": "OmniClip-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "dmg": {
      "title": "OmniClip ${version}"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "artifactName": "OmniClip-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "karammm",
        "repo": "omniclip"
      }
    ],
    "deb": {
      "recommends": [
        "libayatana-appindicator3-1",
        "xdotool"
      ]
    }
  },
  "homepage": "https://github.com/karammm/omniclip",
  "desktopName": "omniclip.desktop"
}
